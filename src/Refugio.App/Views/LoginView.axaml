<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Refugio.App.ViewModels"
             x:Class="Refugio.App.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <Grid ColumnDefinitions="1.15*,*">
    <Border Background="{DynamicResource SidebarBackground}" Padding="56">
      <StackPanel VerticalAlignment="Center" Spacing="18">
        <TextBlock Text="Refugio Animales"
                   FontSize="40"
                   FontWeight="Bold"
                   Foreground="White" />
        <TextBlock Text="Gestión integral del refugio: animales, adopciones, tratamientos y donaciones."
                   FontSize="16"
                   Foreground="#BFD4C4"
                   TextWrapping="Wrap"
                   MaxWidth="430"
                   HorizontalAlignment="Left" />
        <Border Background="#254733" CornerRadius="12" Padding="20" MaxWidth="330" HorizontalAlignment="Left">
          <StackPanel Spacing="6">
            <TextBlock Text="Proyecto universitario" Foreground="#8FB89B" FontSize="12" />
            <TextBlock Text="SGBD II · Programación Visual" Foreground="White" FontSize="18" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Padding="48">
      <StackPanel VerticalAlignment="Center" MaxWidth="360" HorizontalAlignment="Center" Spacing="4">
        <TextBlock Text="Iniciar sesión" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Text="Ingresá con tu cuenta del refugio." Classes="subtitle" Margin="0,0,0,14" />

        <TextBlock Text="Email" Classes="field-label" />
        <TextBox Text="{Binding Email}" Watermark="admin@refugio.local" />

        <TextBlock Text="Contraseña" Classes="field-label" />
        <TextBox Text="{Binding Password}" PasswordChar="*" />

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource Danger}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <Button Content="Ingresar"
                Classes="primary"
                Command="{Binding LoginCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="0,14,0,0"
                IsEnabled="{Binding !IsBusy}" />

        <Border Background="#EAF1EB" CornerRadius="8" Padding="12" Margin="0,18,0,0">
          <StackPanel Spacing="2">
            <TextBlock Text="Cuentas de prueba" FontSize="11" Foreground="{DynamicResource TextMuted}" />
            <TextBlock Text="admin@refugio.local / Admin2026" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="vet@refugio.local / Vet2026" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="voluntario@refugio.local / Voluntario2026" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
