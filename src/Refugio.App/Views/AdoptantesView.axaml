<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Refugio.App.Views.AdoptantesView">
  <Grid RowDefinitions="Auto,Auto,*">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox Text="{Binding Busqueda}" Watermark="Buscar por nombre o email" Width="260" />
      <Button Content="Buscar" Classes="ghost" Command="{Binding LoadCommand}" />
      <Button Content="Nuevo adoptante" Classes="primary" Command="{Binding NewCommand}" />
      <Button Content="Editar" Classes="ghost" Command="{Binding EditSelectedCommand}" IsEnabled="{Binding HasSelection}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,8,0,8">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <Border Classes="card" Padding="0">
        <DataGrid ItemsSource="{Binding Adoptantes}" SelectedItem="{Binding SelectedAdoptante}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="1.4*" />
            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="130" />
            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.4*" />
            <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Grid.Column="1"
              Classes="card"
              Width="340"
              Margin="14,0,0,0"
              IsVisible="{Binding IsEditing}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Datos del adoptante" Classes="section-title" Margin="0,0,0,6" />

            <TextBlock Text="Nombre *" Classes="field-label" />
            <TextBox Text="{Binding EditNombre}" />

            <TextBlock Text="Teléfono" Classes="field-label" />
            <TextBox Text="{Binding EditTelefono}" />

            <TextBlock Text="Email" Classes="field-label" />
            <TextBox Text="{Binding EditEmail}" />

            <TextBlock Text="Dirección" Classes="field-label" />
            <TextBox Text="{Binding EditDireccion}" />

            <TextBlock Text="Notas" Classes="field-label" />
            <TextBox Text="{Binding EditNotas}" AcceptsReturn="True" Height="110" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
              <Button Content="Guardar" Classes="primary" Command="{Binding SaveCommand}" />
              <Button Content="Cancelar" Classes="ghost" Command="{Binding CancelCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
